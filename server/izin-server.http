@H = 'Authorization: Bearer dev-token'
@HA = 'Authorization: Bearer dev-admin-token'
@J = 'content-type: application/json'
@ANA=a707969a-2614-4653-848b-f733ab3540fd
curl -s -X POST http://localhost:8000/v1/principals -H {{HA}} -H {{J}} \
  -d '{"name": "Ana", "roles": ["approver"]}'

###

curl -s -X POST http://localhost:8000/v1/principals -H {{HA}} -H {{J}} \
  -d '{"name": "Mail Tester", "roles": ["approver"], "email": "tester@example.test"}'

###

curl -s -X PUT http://localhost:8000/v1/actions/refund_order -H {{HA}} \
  -H {{J}} -d @examples/action_refund_order.json

###

curl -s -X POST http://localhost:8000/v1/requests -H {{H}} -H {{J}} \
-d @examples/request_refund.json

###

curl -si -X PUT http://localhost:8000/v1/principals/{{ANA}}/slack -H {{HA}} -H {{J}} \
  -d '{"slack_user_id": "U29AGHZ19"}'

###

curl -s "localhost:8000/v1/requests/a68bb52c-bfb1-462d-9745-cfffd539602d/decision?wait=30" -H {{H}}

###

curl -s -X POST http://localhost:8000/v1/requests/f96a033e-194d-4b39-b5b5-f1619476d09b/decision -H {{H}} -H {{J}} \
-d '{"principal_id": "4bedbb66-166a-48ea-abf5-1bef72b243ca", "verdict": "approve"}'

###

curl -s -X POST http://localhost:8000/v1/principals/4bedbb66-166a-48ea-abf5-1bef72b243ca/token \
  -H "Authorization: Bearer dev-admin-token"